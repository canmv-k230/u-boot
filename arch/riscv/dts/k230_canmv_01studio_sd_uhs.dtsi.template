/*
 * TEMPLATE, not built: SPL and U-Boot side of SD UHS-I on the 01Studio boot
 * card (mmc0), matching rtsmart's board/configs/k230_canmv_01studio/
 * regulator_config.c.template. Same hardware assumptions.
 *
 * U-Boot itself stays at 3.3 V signaling. With these supplies its MMC core
 * sets the I/O rail to 3.3 V and power cycles the card on every init, in SPL
 * and in U-Boot proper, so a card that an RT-Smart session left at 1.8 V
 * returns to 3.3 V before U-Boot reads it. The boot ROM runs before this:
 * after a watchdog or reset key the card must already have lost power in
 * hardware, and after a software reboot RT-Smart removes it.
 *
 * To use it:
 *  1. Copy to k230_canmv_01studio_sd_uhs.dtsi, set the GPIOs below (the same
 *     as in the RT-Smart table), and add to k230_canmv_01studio.dts:
 *       #include "k230_canmv_01studio_sd_uhs.dtsi"
 *     The pins must be GPIOs in k230_canmv_01studio_iomux.dtsi.
 *  2. Add to configs/k230_canmv_01studio_defconfig:
 *       CONFIG_DM_GPIO=y
 *       CONFIG_SPL_GPIO=y
 *       CONFIG_SPL_DM_GPIO=y
 *       CONFIG_DWAPB_GPIO=y
 *       CONFIG_SPL_DWAPB_GPIO=y
 *       CONFIG_DM_REGULATOR=y
 *       CONFIG_SPL_POWER=y
 *       CONFIG_SPL_DM_REGULATOR=y
 *       CONFIG_DM_REGULATOR_GPIO=y
 *       CONFIG_SPL_DM_REGULATOR_GPIO=y
 *       CONFIG_DM_REGULATOR_FIXED=y
 *       CONFIG_SPL_DM_REGULATOR_FIXED=y
 *       CONFIG_MMC_IO_VOLTAGE=y
 *       CONFIG_SPL_MMC_IO_VOLTAGE=y
 *     Leave MMC_UHS_SUPPORT off: U-Boot does not need 1.8 V.
 *  3. Rebuild U-Boot (CONFIG_UBOOT_USE_PREBUILT off in the SDK).
 */

#include <dt-bindings/gpio/gpio.h>

/* GPIO switching the SD0 I/O rail. Wire it so that low selects 3.3 V: the
 * regulator drives it low when it probes, before the MMC core sets 3.3 V. */
#define SD0_IO_SELECT_PIN       (-1)
/* GPIO enabling the card's 3.3 V VDD. The boot ROM needs the card powered,
 * so the switch must be on by reset default (pull resistor). */
#define SD0_POWER_ENABLE_PIN    (-1)

#if SD0_IO_SELECT_PIN < 0 || SD0_POWER_ENABLE_PIN < 0
#error "Set SD0_IO_SELECT_PIN and SD0_POWER_ENABLE_PIN"
#endif

/* IO0-31 are on gpio0 port A, IO32-63 on gpio1 port A, IO64-71 on gpio1
 * port B. */
/ {
	sd0_vqmmc: regulator-sd0-vqmmc {
		compatible = "regulator-gpio";
		regulator-name = "sd0_vqmmc";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
#if SD0_IO_SELECT_PIN < 32
		gpios = <&gpio0_porta SD0_IO_SELECT_PIN GPIO_ACTIVE_HIGH>;
#elif SD0_IO_SELECT_PIN < 64
		gpios = <&gpio1_porta (SD0_IO_SELECT_PIN - 32) GPIO_ACTIVE_HIGH>;
#else
		gpios = <&gpio1_portb (SD0_IO_SELECT_PIN - 64) GPIO_ACTIVE_HIGH>;
#endif
		/* select pin low: 3.3 V, high: 1.8 V */
		states = <3300000 0x0 1800000 0x1>;
		u-boot,dm-pre-reloc;
	};

	sd0_vmmc: regulator-sd0-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "sd0_vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
#if SD0_POWER_ENABLE_PIN < 32
		gpio = <&gpio0_porta SD0_POWER_ENABLE_PIN GPIO_ACTIVE_HIGH>;
#elif SD0_POWER_ENABLE_PIN < 64
		gpio = <&gpio1_porta (SD0_POWER_ENABLE_PIN - 32) GPIO_ACTIVE_HIGH>;
#else
		gpio = <&gpio1_portb (SD0_POWER_ENABLE_PIN - 64) GPIO_ACTIVE_HIGH>;
#endif
		enable-active-high;
		/* Card VDD ramp; check on the board. */
		startup-delay-us = <1000>;
		u-boot,dm-pre-reloc;
	};
};

&gpio0 {
	status = "okay";
	u-boot,dm-pre-reloc;
};

&gpio0_porta {
	u-boot,dm-pre-reloc;
};

&gpio1 {
	status = "okay";
	u-boot,dm-pre-reloc;
};

&gpio1_porta {
	u-boot,dm-pre-reloc;
};

&gpio1_portb {
	u-boot,dm-pre-reloc;
};

&mmc0 {
	vmmc-supply = <&sd0_vmmc>;
	vqmmc-supply = <&sd0_vqmmc>;
};
