if TARGET_K230_CANMV_MRT

    config SYS_CPU
        default "k230"

    config SYS_VENDOR
        default "kendryte"

    config SYS_BOARD
        default "k230_canmv_mrt"

    config SYS_CONFIG_NAME
        default "k230_common"

    config BOARD_SPECIFIC_OPTIONS
        def_bool y
        select KENDRYTE_K230

    choice
        prompt "DDR Type And Frequency"
        default CANMV_MRT_LPDDR4_2667

        config CANMV_MRT_LPDDR4_2667
            bool "k230 canmv mrt ddr4 2667"    
    endchoice
endif
