if TARGET_K230_CANMV_WONDERMK

	config SYS_CPU
		default "k230"

	config SYS_VENDOR
		default "kendryte"

	config SYS_BOARD
		default "k230_canmv_wondermk"

	config SYS_CONFIG_NAME
		default "k230_common"

	config BOARD_SPECIFIC_OPTIONS
		def_bool y
		select KENDRYTE_K230

	choice
		prompt "DDR Type And Frequency"
		default CANMV_WONDERMK_LPDDR4_2667

		config CANMV_WONDERMK_LPDDR3_2133
			bool "LPDDR3@2133"
		config CANMV_WONDERMK_LPDDR3_1600
			bool "LPDDR3@1600"
		config CANMV_WONDERMK_LPDDR3_800
			bool "LPDDR3@800"
		config CANMV_WONDERMK_LPDDR4_2667
			bool "LPDDR4@2667"
		config CANMV_WONDERMK_LPDDR4_3200
			bool "LPDDR4@3200"
		config CANMV_WONDERMK_LPDDR4_1066_NODT
			bool "LPDDR4@1066 NODT"
		config CANMV_WONDERMK_LPDDR4_1066
			bool "LPDDR4@1066 "
	endchoice

endif
