if TARGET_K230_CANMV_ROCKBASE

        config SYS_CPU
                default "k230"

        config SYS_VENDOR
                default "kendryte"

        config SYS_BOARD
                default "k230_canmv_rockbase"

        config SYS_CONFIG_NAME
                default "k230_common"

        config BOARD_SPECIFIC_OPTIONS
                def_bool y
                select KENDRYTE_K230

        choice
                prompt "DDR Type And Frequency"
                default CANMV_ROCKBASE_LPDDR4_2667

                config CANMV_ROCKBASE_LPDDR4_2667
                        bool "LPDDR4@2667"
                config CANMV_ROCKBASE_LPDDR4_1066
                        bool "LPDDR4@1066"
                config CANMV_ROCKBASE_LPDDR4_1066_NODT
                        bool "LPDDR4@1066 WITHOUT ODT"
        endchoice

endif
